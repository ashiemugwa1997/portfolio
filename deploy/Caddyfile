# Caddy: automatic HTTPS (Let's Encrypt), HTTP -> HTTPS, HTTP/2 and HTTP/3.
# sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
www.samugwambi.site {
	redir https://samugwambi.site{uri} permanent
}

samugwambi.site {
	encode zstd gzip

	# the server does the rest of the headers; HSTS is sent by it when HTTPS=1
	header -Server

	# Behind Cloudflare's proxy the visitor is in CF-Connecting-IP, but only a request that really
	# comes from Cloudflare may say so (https://www.cloudflare.com/ips/). Anything else: the peer.
	@cloudflare remote_ip 		173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 \
		190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
		104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 \
		2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @cloudflare {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			# replace, not append: a client cannot plant its own first entry
			header_up X-Forwarded-For {remote_host}
		}
	}

	request_body {
		max_size 32KB
	}
}
