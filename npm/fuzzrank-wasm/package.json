{
  "name": "fuzzrank-wasm",
  "version": "0.2.1",
  "description": "Fast fuzzy search for command palettes and filters, in 47 KB of Rust-built WebAssembly. Every word must match; highlight positions included.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./fuzzrank.wasm": "./fuzzrank.wasm"
  },
  "files": ["index.js", "index.d.ts", "fuzzrank.wasm", "README.md", "LICENSE"],
  "sideEffects": false,
  "keywords": ["fuzzy", "search", "command-palette", "wasm", "webassembly", "filter", "rust"],
  "author": "Ashley Mugwambi",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ashiemugwa1997/portfolio.git", "directory": "npm/fuzzrank-wasm" },
  "homepage": "https://crates.io/crates/fuzzrank",
  "engines": { "node": ">=18" },
  "scripts": { "test": "node --test test.mjs" }
}
